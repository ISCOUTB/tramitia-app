  username: {{coordinacion_usuario}}
  password: {{coordinacion_clave}}
}

body:json {
  {}
}

assert {
  res.status: eq 200
}

docs {
  Invocacion directa de la herramienta, sin el modelo de por medio. La
  usa el tablero del comite para armar el orden del dia.
}
