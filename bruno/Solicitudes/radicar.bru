meta {
  name: Radicar solicitud
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/solicitudes
  body: json
  auth: basic
}

auth:basic {
  username: {{analista_usuario}}
  password: {{analista_clave}}
}

body:json {
  {
    "area": "salud",
    "resumen": "Clasificar la solicitud de atencion del radicado de prueba",
    "prioridad": 3
  }
}

assert {
  res.status: eq 201
  res.body.propietario: eq ana.vargas
}

vars:post-response {
  solicitud_creada: res.body.id
}

docs {
  El propietario lo determina la sesion y no se acepta en el cuerpo.

  Guarda el identificador creado en la variable `solicitud_creada`.
}
