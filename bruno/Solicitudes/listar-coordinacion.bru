meta {
  name: Listar - coordinacion
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/solicitudes
  body: none
  auth: basic
}

auth:basic {
  username: {{coordinacion_usuario}}
  password: {{coordinacion_clave}}
}

assert {
  res.status: eq 200
}

docs {
  El rol coordinador recibe el listado completo, que es lo que necesita
  el comite semanal.
}
