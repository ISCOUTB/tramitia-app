# Copie este archivo como .env y ajuste los valores del ambiente.

# Clave de firma de la aplicacion. En produccion la entrega el gestor de
# secretos de la DSC; si no se define, la aplicacion usa un valor de respaldo.
TRAMITIA_SECRET=tramitia-dev-secret-cambiar-en-produccion

TRAMITIA_DATABASE=tramitia.sqlite3
TRAMITIA_AUDITORIA=tramitia-auditoria.jsonl

TRAMITIA_HOST=127.0.0.1
TRAMITIA_PORT=5050

# Recarga automatica y trazas en el navegador. Comodo para desarrollar.
TRAMITIA_DEBUG=1

# Cliente de modelo. El paquete de entrega incluye los dos clientes locales:
#   local       determinista, es el que usan las pruebas
#   muestreado  con variabilidad; acepta semilla
TRAMITIA_MODELO=local
TRAMITIA_MODELO_SEMILLA=

# Transporte de la herramienta consultar_referencia. El paquete solo incluye
# el catalogo local (perfil sin conexion).
TRAMITIA_TRANSPORTE=offline

# Invocaciones del asistente por usuario mientras el proceso este arriba.
TRAMITIA_PRESUPUESTO_ASISTENTE=60
